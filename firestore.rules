rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Salt de chiffrement par utilisateur — lisible/modifiable uniquement par son propriétaire.
    match /userSalts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Coffres, dossiers et entrées — accessibles uniquement par leur propriétaire.
    match /vaults/{userId}/coffres/{coffreId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /vaults/{userId}/folders/{folderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /vaults/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
